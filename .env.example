# Скопируй в .env и заполни.

# PandaScore (бесплатный ключ: https://app.pandascore.co) — расписание и история матчей
PANDASCORE_TOKEN=

# Telegram-бот (создать у @BotFather); chat id можно узнать у @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# BetBoom: страница CS2 (для режима playwright) и/или прямой JSON-эндпоинт из DevTools (режим url)
BETBOOM_CS2_URL=https://betboom.ru/sport/esports/counter-strike
BETBOOM_JSON_URL=

# Фильтр сигналов
MIN_ODDS=1.55
MAX_ODDS=1.85
MIN_EV=0.07
HORIZON_HOURS=48
MAX_EV=0.30
